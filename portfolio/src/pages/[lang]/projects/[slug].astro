---
import Layout from '../../../layouts/Layout.astro';
import { projects, languages, type Lang } from '../../../data/portfolio';
import Media from '../../../components/Media.astro';
import ConsoleExplorer from '../../../components/ConsoleExplorer.astro';
export function getStaticPaths() { return languages.flatMap(lang => projects.map(project => ({ params: { lang, slug: project.slug }, props: { project } }))); }
const { project: p } = Astro.props;
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const next = projects[(projects.findIndex(item => item.slug === p.slug) + 1) % projects.length];
const images = p.slug === 'wuehans' ? p.images.slice(0,3) : p.images;
---
<Layout lang={lang} title={p.title} description={p.summary[lang]}>
  <section class="case-hero wrap"><a class="back-link mono" href={`/${lang}/#work`}>← {de ? 'ALLE PROJEKTE' : 'ALL PROJECTS'}</a><div class="case-heading"><span class="eyebrow">PROJECT {p.number} / {p.year}</span><h1>{p.title}</h1><p class="lead">{p.summary[lang]}</p></div><div class="case-meta"><div><span class="eyebrow">{de ? 'MEIN BEITRAG' : 'MY CONTRIBUTION'}</span><p>{p.contribution[lang]}</p></div><div><span class="eyebrow">TEAM</span><p>{p.team[lang]}</p></div><div><span class="eyebrow">{de ? 'ZEITRAUM' : 'TIMELINE'}</span><p>{p.duration[lang]}</p></div></div><div class="case-links">{p.links.map(link => <a class="button secondary" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[lang]} ↗</a>)}{p.video && <a class="text-link" href="#gameplay">{de ? 'Video ansehen' : 'Watch the video'} ↓</a>}</div></section>
  <div class:list={['case-cover', 'wrap', { 'console-cover': p.slug === 'wuehans' }]}>{p.slug === 'wuehans' ? <ConsoleExplorer lang={lang} /> : <Media name={p.image} lang={lang} eager />}</div>
  <section class="case-story wrap"><div class="story-index mono"><span>{de ? 'HINTER DEM SPIEL' : 'BEHIND THE PLAY'}</span><span>{p.tags[0]}</span></div><div class="story-content"><article><span class="eyebrow">01 / {de ? 'DIE AUFGABE' : 'THE CHALLENGE'}</span><h2>{de ? 'Das Designproblem.' : 'The design problem.'}</h2><p>{p.problem[lang]}</p></article><article><span class="eyebrow">02 / {de ? 'DIE UMSETZUNG' : 'THE IMPLEMENTATION'}</span><h2>{de ? 'Von der Idee zum System.' : 'From idea to system.'}</h2><p>{p.implementation[lang]}</p></article><article><span class="eyebrow">03 / {de ? 'DAS ERGEBNIS' : 'THE OUTCOME'}</span><h2>{de ? 'Was daraus entstand.' : 'What came out of it.'}</h2><p>{p.outcome[lang]}</p></article><aside class="reflection"><span class="eyebrow">↳ {de ? 'DESIGNPERSPEKTIVE' : 'DESIGN LENS'}</span><p>{p.reflection[lang]}</p></aside></div></section>
  {images.length > 0 && <section class="section wrap case-gallery"><div class="section-heading"><div><span class="eyebrow">{de ? 'AUS DEM PROJEKT' : 'FROM THE PROJECT'}</span><h2>{de ? 'Ein genauerer Blick.' : 'A closer look.'}</h2></div></div><div class="gallery-grid">{images.map((name,i) => <figure id={p.slug === 'wuehans' ? ['architecture','gpu','apu'][i] : undefined}><a href={`/media/${name}-1280.webp`} target="_blank" rel="noopener noreferrer"><Media name={name} lang={lang} /></a><figcaption class="mono">{p.slug === 'wuehans' ? ['SYSTEM ARCHITECTURE','GPU PIPELINE','APU ARCHITECTURE'][i] : `${p.title} / ${String(i+1).padStart(2,'0')}`} ↗</figcaption></figure>)}</div></section>}
  {p.slug === 'wuehans' && <section class="section wrap" id="games"><div class="section-heading"><div><span class="eyebrow">BUILT FOR WUEHANS</span><h2>{de ? 'Eine Konsole. Vier Spiele.' : 'One console. Four games.'}</h2></div></div><div class="console-games">{['tennis','tower','gatherer','cow'].map((name,i) => <figure><Media name={name} lang={lang} /><figcaption>{['Hans Tennis','Hans Tower Defence','Hans The Gatherer','Cow Shooter'][i]}</figcaption></figure>)}</div></section>}
  {p.slug === 'tony-blob' && <aside class="wrap review-note"><span class="eyebrow">{de ? 'ZUR SPIELSICHTUNG' : 'ABOUT THE PLAY REVIEW'}</span><p>{de ? 'Der lokale Windows-Build wurde erfolgreich gestartet und der Einstieg visuell gesichtet. Eine belastbare Erprobung des Bounce-Loops war über die verfügbaren Eingaben nicht möglich. Die Beschreibung der Mechaniken oben beruht deshalb auf der Portfolio-Dokumentation; sie ist keine vollständige Gameplay-Review.' : 'The local Windows build was launched successfully and its opening scene inspected visually. The available inputs did not allow a reliable test of the bounce loop. The mechanics described above therefore come from the portfolio documentation; this is not a full gameplay review.'}</p></aside>}
  {p.video && <section class="section wrap" id="gameplay"><div class="section-heading"><div><span class="eyebrow">{de ? 'IN BEWEGUNG' : 'IN MOTION'}</span><h2>{de ? 'Das Projekt im Video.' : 'See it in motion.'}</h2></div></div><div class="video-shell" data-video={p.video}><Media name={p.slug === 'wuehans' ? 'cow' : p.image} lang={lang} /><div><button class="button primary" type="button" data-play-video>{de ? 'Video laden & abspielen' : 'Load & play video'} <span aria-hidden="true">▶</span></button><p>{de ? 'Erst beim Klick wird eine Verbindung zu YouTube hergestellt.' : 'YouTube is only contacted after you press play.'}</p><a href={`https://www.youtube.com/watch?v=${p.video}`} target="_blank" rel="noopener noreferrer">{de ? 'Direkt auf YouTube ansehen' : 'Watch directly on YouTube'} ↗</a></div></div></section>}
  <section class="next-project wrap"><span class="eyebrow">{de ? 'NÄCHSTES PROJEKT' : 'NEXT PROJECT'} / {next.number}</span><a href={`/${lang}/projects/${next.slug}/`}>{next.title} <span aria-hidden="true">↗</span></a><a class="text-link" href={`/${lang}/#contact`}>{de ? 'Über ein Projekt sprechen' : 'Let’s talk about a project'} ↗</a></section>
</Layout>
<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach(shell => {
    shell.querySelector('[data-play-video]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${shell.dataset.video}?autoplay=1`;
      frame.title = document.documentElement.lang === 'de' ? 'Projektvideo auf YouTube' : 'Project video on YouTube';
      frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      shell.replaceChildren(frame);
    });
  });
</script>
