---
import Layout from '../../layouts/Layout.astro';
import { projects, languages, type Lang } from '../../data/portfolio';
import ConsoleExplorer from '../../components/ConsoleExplorer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Skills from '../../components/Skills.astro';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const wue = projects[0];
---
<Layout lang={lang} section="home">
  <section class="hero wrap">
    <div class="hero-topline"><span class="eyebrow"><span class="tiny-cross" aria-hidden="true">+</span> {de ? 'TECHNIK IM KOPF. SPIELGEFÜHL IM FOKUS.' : 'TECHNICAL MIND. PLAYFUL INSTINCT.'}</span><span class="mono hero-coordinate" aria-hidden="true">[ YS — 01 ]</span></div>
    <h1>{de ? 'Systeme mit Tiefe.' : 'Serious systems.'}<br /><span>{de ? 'Spiele mit Gefühl.' : 'Playful outcomes.'}</span><span class="hero-period" aria-hidden="true">*</span></h1>
    <div class="hero-bottom"><div class="hero-intro"><p class="hero-name">Yannik Stamm <span>/ Technical Game Designer</span></p><p>{de ? 'Ich gestalte Spielsysteme und entwickle das Gameplay, das sie spürbar macht.' : 'I design game systems and build the gameplay that brings them to life.'}</p></div><a href="#work" class="button primary">{de ? 'Projekte entdecken' : 'Explore my work'} <span aria-hidden="true">↓</span></a></div>
    <div class="discipline-line mono"><span>SYSTEMS DESIGN</span><span aria-hidden="true">×</span><span>GAMEPLAY PROGRAMMING</span><span aria-hidden="true">×</span><span>GAME FEEL</span></div>
  </section>

  <section id="work" class="section wrap">
    <div class="section-heading"><div><span class="eyebrow">01 / {de ? 'LEITPROJEKT' : 'FEATURED PROJECT'}</span><h2>{de ? 'Vom System zum Spiel.' : 'From the system up.'}</h2></div><span class="mono section-side">HARDWARE × SOFTWARE × PLAY</span></div>
    <article class="featured-project"><div class="featured-intro"><div><span class="project-badge mono">{de ? 'EIGENE FPGA-KONSOLE' : 'CUSTOM FPGA CONSOLE'}</span><h3>WUEHANS<span aria-hidden="true">↗</span></h3><p>{wue.summary[lang]}</p></div><div class="featured-facts"><span class="mono">2024 — 2025 / {wue.team[lang]}</span><p>{wue.contribution[lang]}</p><a class="text-link" href={`/${lang}/projects/wuehans/`}>{de ? 'Zur ganzen Geschichte' : 'Read the full story'} <span aria-hidden="true">↗</span></a></div></div><ConsoleExplorer lang={lang} /></article>
  </section>

  <section class="section wrap" id="games"><div class="section-heading"><div><span class="eyebrow">02 / {de ? 'AUSGEWÄHLTE SPIELE' : 'SELECTED GAMES'}</span><h2>{de ? 'Ideen, die spielbar werden.' : 'Ideas you can play.'}</h2></div><p class="section-aside">{de ? 'Controller, Spielsysteme und die Details dazwischen.' : 'Controllers, game systems, and the details in between.'}</p></div><div class="projects-grid">{projects.slice(1,4).map(project => <ProjectCard project={project} lang={lang} />)}</div></section>

  <section class="section wrap further-work"><div class="section-heading"><div><span class="eyebrow">03 / {de ? 'WEITERE EXPERIMENTE' : 'MORE EXPLORATIONS'}</span><h2>{de ? 'Kleine Teams. Schnelle Ideen.' : 'Small teams. Fast ideas.'}</h2></div><span class="mono section-side">PROTOTYPE → PLAY → ITERATE</span></div><div class="projects-grid">{projects.slice(4).map(project => <ProjectCard project={project} lang={lang} small />)}</div></section>

  <section id="skills" class="section wrap skills-section"><div class="section-heading"><div><span class="eyebrow">04 / {de ? 'WERKZEUGKASTEN' : 'THE TOOLKIT'}</span><h2>{de ? 'Skills mit Spielbelegen.' : 'Skills, backed by play.'}</h2></div><p class="section-aside">{de ? 'Jede Fähigkeit führt zu ihrer Anwendung.' : 'Every skill has a story behind it.'}</p></div><p class="draft-note"><span aria-hidden="true">↳</span> {de ? 'Vorläufige Einschätzung — Level sind noch zu bestätigen. Erfahrungsangaben stammen aus dem Portfolio.' : 'Draft assessment — levels are awaiting confirmation. Experience is based on the supplied portfolio.'}</p><Skills lang={lang} /><details class="level-key"><summary>{de ? 'Wie die vier Level zu lesen sind' : 'How to read the four levels'} <span aria-hidden="true">+</span></summary><ol><li>{de ? 'Grundlagen: mit Konzepten und Werkzeugen vertraut.' : 'Foundations: familiarity with concepts and tools.'}</li><li>{de ? 'Angewendet: in konkreten Projekten eingesetzt.' : 'Applied: used in concrete projects.'}</li><li>{de ? 'Selbstständig: eigenständige Umsetzung von Funktionen.' : 'Independent: self-directed feature implementation.'}</li><li>{de ? 'Vertieft: komplexe, zusammenhängende Systeme umgesetzt.' : 'In-depth: implementation across complex, connected systems.'}</li></ol></details></section>

  <section id="about" class="section wrap about-section"><div><span class="eyebrow">05 / {de ? 'DER MENSCH DAHINTER' : 'THE PERSON BEHIND THE PLAY'}</span><h2>{de ? 'Neugierig auf das,' : 'Curious about'}<br />{de ? 'was darunterliegt.' : 'what makes it tick.'}<span class="lime">*</span></h2></div><div class="about-copy"><p class="lead">{de ? 'Hi, ich bin Yannik. Mich interessiert, wie gute Systeme zu gutem Spielgefühl werden.' : 'Hi, I’m Yannik. I’m interested in how good systems become great-feeling games.'}</p><p>{de ? 'Mein Schwerpunkt liegt auf systembasiertem Game Design, Gameplay-Programmierung und Feedback. Ich arbeite vor allem mit Unity/C# und bringe Erfahrung mit C++ mit — vom Character Controller bis zur eigenen Engine und FPGA-Konsole.' : 'My focus is system-based game design, gameplay programming and feedback. I primarily work with Unity/C# and bring experience in C++ — from character controllers to a custom engine and an FPGA console.'}</p><p>{de ? 'Ich habe einen Bachelor in Games Engineering. Meine Projekte verbinden technische Umsetzung, iterative Entwicklung und interdisziplinäre Zusammenarbeit.' : 'I hold a bachelor’s degree in Games Engineering. My projects connect technical implementation, iterative development and interdisciplinary collaboration.'}</p><div class="about-facts mono"><span>{de ? 'DEUTSCH / ENGLISCH' : 'GERMAN / ENGLISH'}</span><span>{de ? 'DESIGN ↔ ENTWICKLUNG' : 'DESIGN ↔ DEVELOPMENT'}</span></div></div></section>

  <section id="music" class="music-section wrap"><div class="music-mark" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div><span class="eyebrow">SIDE A / {de ? 'AUCH IM MIX' : 'ALSO IN THE MIX'}</span><h2>{de ? 'Spielgefühl hat einen Sound.' : 'Game feel has a soundtrack.'}</h2><p>{de ? 'Ich komponiere gelegentlich Spielmusik und schreibe Arrangements. Hier sind zwei eigene Soundtracks.' : 'I also compose game music and write arrangements. Here are two original soundtracks.'}</p></div><div class="music-links"><a href="https://www.youtube.com/watch?v=vR241HJ-DG0" target="_blank" rel="noopener noreferrer">Crocodile Invasion OST ↗</a><a href="https://www.youtube.com/watch?v=2d14ZWxVkBs" target="_blank" rel="noopener noreferrer">Tony Blob’s Pro Bouncer OST ↗</a><a href="https://soundcloud.com/user-569467534" target="_blank" rel="noopener noreferrer">SoundCloud ↗</a></div></section>

  <section id="contact" class="contact-section wrap"><span class="eyebrow">06 / {de ? 'NÄCHSTES KAPITEL' : 'THE NEXT CHAPTER'}</span><div class="contact-main"><h2>{de ? 'Gutes Spiel beginnt' : 'Good play starts'}<br />{de ? 'mit einem Gespräch.' : 'with a conversation.'}</h2><a class="contact-arrow" href="mailto:yannik.stamm@gmx.net" aria-label={de ? 'Yannik eine E-Mail schreiben' : 'Email Yannik'}>↗</a></div><div class="contact-bottom"><a class="email-link" href="mailto:yannik.stamm@gmx.net">yannik.stamm@gmx.net</a><a class="button secondary" href="/Yannik-Stamm-Portfolio.pdf" download>Portfolio PDF <span aria-hidden="true">↓</span></a></div></section>
</Layout>
