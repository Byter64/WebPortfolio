---
import Layout from '../../layouts/Layout.astro';
import { languages, projects, type Lang } from '../../data/portfolio';
import Skills from '../../components/Skills.astro';
import ConsoleExplorer from '../../components/ConsoleExplorer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const colours = [['Graphite','#141817'],['Module','#202723'],['Warm white','#F3F1E8'],['Sage grey','#AFBAB2'],['Electric lime','#C7F464'],['Warm orange','#FFAD70']];
---
<Layout lang={lang} section="board" title="Designboard">
  <section class="board-hero wrap"><span class="eyebrow">DESIGN SYSTEM / 01</span><h1>Systems<br />of <span class="lime">Play.</span></h1><div><p class="lead">{de ? 'Ein Hardware-Spielplatz für ein Technical-Game-Design-Portfolio.' : 'A hardware playground for a technical game design portfolio.'}</p><p>{de ? 'Graphit, präzise Typografie und ein elektrischer Akzent. Echte Projekte geben den Ton an.' : 'Graphite, precise typography and an electric accent. Real projects set the tone.'}</p><a href={`/${lang}/`} class="button primary">{de ? 'Beispielseite ansehen' : 'View the example page'} ↗</a></div></section>
  <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">01 / PALETTE</span><h2>{de ? 'Ruhe trifft Energie.' : 'Quiet meets electric.'}</h2></div></div><div class="swatches">{colours.map(([name,hex]) => <div class="swatch"><div style={`background:${hex}`}><span style={`color:${['#141817','#202723'].includes(hex) ? '#F3F1E8' : '#141817'}`}>Aa</span></div><h3>{name}</h3><span class="mono">{hex}</span></div>)}</div></section>
  <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">02 / TYPOGRAPHY</span><h2>{de ? 'Charakter. Klarheit. Detail.' : 'Character. Clarity. Detail.'}</h2></div></div><div class="type-grid"><article class="type-spec display-spec"><span class="mono">SPACE GROTESK / 600 · 700</span><p>Built to<br /><span class="lime">be played.</span></p><span class="mono">Aa Bb Cc · 0123456789</span></article><article class="type-spec"><span class="mono">INTER / 400 · 500</span><h3>{de ? 'Gute Systeme werden spürbar.' : 'Good systems become tangible.'}</h3><p>{de ? 'Ich gestalte Spielsysteme und entwickle das Gameplay, das sie spürbar macht. Lesbare Texte erklären Entscheidungen, ohne dem Projekt die Bühne zu nehmen.' : 'I design game systems and build the gameplay that brings them to life. Readable copy explains decisions while leaving room for the work.'}</p><div class="mono-spec"><span class="mono">IBM PLEX MONO / 400</span><p class="mono">01 / SYSTEMS DESIGN<br />GPU → APU → PLAY<br />[ LVL 03 / 04 ]</p></div></article></div></section>
  <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">03 / COMPONENTS</span><h2>{de ? 'Kleine Teile. Ein System.' : 'Small parts. One system.'}</h2></div></div><div class="component-grid"><div class="component-sample"><span class="mono">BUTTONS / LINKS</span><a class="button primary" href={`/${lang}/#work`}>{de ? 'Projekte entdecken' : 'Explore my work'} ↓</a><a class="button secondary" href="/Yannik-Stamm-Portfolio.pdf" download>Portfolio PDF ↓</a><a class="text-link" href={`/${lang}/projects/wuehans/`}>{de ? 'Fallstudie ansehen' : 'Read the case study'} ↗</a></div><div class="component-sample"><span class="mono">SKILL SEGMENTS / EVIDENCE</span><p class="draft-note">{de ? 'Entwurfswerte — noch zu bestätigen.' : 'Draft levels — awaiting confirmation.'}</p><Skills lang={lang} sample /></div><div class="component-sample"><span class="mono">PROJECT CARD</span><ProjectCard project={projects[1]} lang={lang} /></div></div></section>
  <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">04 / OPTIONAL DISCOVERY</span><h2>{de ? 'Ein Blick ins Innenleben.' : 'A look under the hood.'}</h2></div><p class="section-aside">{de ? 'Drei Hotspots. Alles direkt zugänglich. Probiere Grafik, Audio und Spiele aus.' : 'Three hotspots. Everything directly accessible. Try graphics, audio and games.'}</p></div><div class="board-console"><ConsoleExplorer lang={lang} compact /></div></section>
  <section class="section wrap board-principles"><span class="eyebrow">05 / PRINCIPLES</span><div><h2>{de ? 'Spielerisch im Detail.' : 'Playful in the details.'}<br />{de ? 'Klar im Gesamtbild.' : 'Clear in the big picture.'}</h2><p>{de ? 'Keine Pflichtaufgaben. Keine versteckten Inhalte. Projektbeiträge, Kontakt und PDF sind immer erreichbar. Tastatur, Touch und reduzierte Bewegung gehören zum System.' : 'No mandatory tasks. No hidden content. Project contributions, contact and the PDF are always accessible. Keyboard, touch and reduced motion are part of the system.'}</p><a class="button primary" href={`/${lang}/`}>{de ? 'Zum Portfolio-Entwurf' : 'Open the portfolio preview'} ↗</a></div></section>
</Layout>
