---
import { imageAlts, type Lang } from '../data/portfolio';
interface Props { name: string; lang: Lang; eager?: boolean; class?: string; }
const { name, lang, eager = false, class: className = '' } = Astro.props;
---
<img class={className} src={`/media/${name}-1280.webp`} srcset={`/media/${name}-640.webp 640w, /media/${name}-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 60vw, 760px" alt={imageAlts[name]?.[lang] ?? name} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1280" height={name === 'console' ? '1041' : '720'} />
